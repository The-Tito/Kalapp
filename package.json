{
  "name": "kalapp",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @kalapp/api --filter @kalapp/web dev",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm --filter @kalapp/web build",
    "deploy": "pnpm build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply kalapp-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply kalapp-db --remote"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "typescript": "6.0.3",
    "vitest": "4.1.12",
    "wrangler": "4.157.0"
  }
}
