# Cabeceras de Workers static assets (Vite copia este archivo a dist/).
# Si varias reglas fijan la misma cabecera, Cloudflare las une con comas; por eso /assets/*
# quita (con "!") el Cache-Control de /* antes de poner el suyo.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; worker-src 'self'; manifest-src 'self'; media-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(self), microphone=(), geolocation=()
  Cache-Control: no-cache

/sw.js
  ! Cache-Control
  Cache-Control: no-cache

/index.html
  ! Cache-Control
  Cache-Control: no-cache

/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
